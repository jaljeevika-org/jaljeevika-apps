# Jaljeevika App Portal — environment variables
# Copy to .env.local (or set them in Vercel → Project → Settings → Environment
# Variables). Never commit real values. Nothing here reaches the browser.

# --- Database (Neon PostgreSQL) -------------------------------------------
# Pooled connection (host contains "-pooler") for the running app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct connection for migrations (same host without "-pooler").
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Optional: connections per server instance (default 5).
# DB_POOL_MAX=5

# --- Public addresses (no trailing slash) --------------------------------
APP_BASE_URL=https://app.jaljeevika.org
# Optional overrides; by default they are derived from APP_BASE_URL.
# API_BASE_URL=https://app.jaljeevika.org/api
# PASSWORD_RESET_URL=https://app.jaljeevika.org/reset-password
# EMAIL_VERIFICATION_URL=https://app.jaljeevika.org/verify-email

# --- Email ----------------------------------------------------------------
# smtp | resend | brevo | console (development only) | none
EMAIL_PROVIDER=smtp
FROM_EMAIL=no-reply@jaljeevika.org
FROM_NAME=Jaljeevika App Portal
# SMTP (Brevo, Zoho, Google Workspace, Amazon SES, …)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_SECURE=true   # default: true only for port 465
# Resend API (EMAIL_PROVIDER=resend)
# RESEND_API_KEY=
# Brevo API (EMAIL_PROVIDER=brevo)
# BREVO_API_KEY=

# --- Logo storage ---------------------------------------------------------
# s3 = Neon Object Storage bucket (default when the AWS_* values below exist)
# database = keep logo bytes in Postgres
# STORAGE_DRIVER=s3
# STORAGE_BUCKET=data
# Written by `neon link` / `neon env pull`:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=us-east-2

# --- Token lifetimes (optional) -------------------------------------------
# PASSWORD_RESET_TTL_MINUTES=60
# INVITE_TTL_HOURS=72
# EMAIL_VERIFICATION_TTL_HOURS=24

# --- Advanced (optional) --------------------------------------------------
# COOKIE_SECURE=true                    # force Secure cookies (default: on for https)
# SERVER_ACTIONS_ALLOWED_ORIGINS=       # extra hosts behind a reverse proxy
# SEED_DEMO_PASSWORD=                   # only for `npm run db:seed -- --demo-users`
